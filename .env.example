# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SECRET_KEY=your-service-role-key

# Optional dev convenience: set to 1 to skip the auth check on admin pages
# and use an auto-created "Dev Org" instead. Gated on NODE_ENV !== production
# so it can never take effect on a deployed build.
# ZIPPLAN_DEV_AUTH_BYPASS=1
